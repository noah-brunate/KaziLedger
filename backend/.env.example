APP_ENV=local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5431/kaziledger
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_URL=http://localhost:3000
AUTO_CREATE_SCHEMA=true
SEED_DEMO_DATA=true
DEFAULT_CURRENCY=UGX
EXPERT_RESPONSE_HOURS=24
ESCROW_RELEASE_HOURS=72
PLATFORM_COMMISSION_RATE=0.10
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_IPN_URL=https://api.example.com/api/v1/payments/pesapal/ipn
PESAPAL_CALLBACK_URL=http://localhost:3000/payments/callback
